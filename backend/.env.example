# =============================================================================
# Track It Backend — Environment Variables
# Copy to .env and set values. Do not commit .env.
# =============================================================================

# Server
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/trackit

# Redis (sessions, refresh tokens, OTP, rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

# -----------------------------------------------------------------------------
# Phase 2: Authentication & Authorization
# -----------------------------------------------------------------------------
# Required. Used for signing/verifying JWT access tokens (and refresh if not set).
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Optional. If set, access and refresh use separate secrets (recommended for production).
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=

# Optional. Defaults: 15m (access), 7d (refresh).
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# Email (Phase 4 — optional until then; password reset OTP is logged to console)
# -----------------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@trackit.com

# -----------------------------------------------------------------------------
# File storage / AWS (later phases)
# -----------------------------------------------------------------------------
# UPLOAD_PATH=./uploads
# MAX_FILE_SIZE=5242880
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=us-east-1
