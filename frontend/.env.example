# =============================================================================
# Track It Frontend — Environment Variables
# Copy to .env and set values. Do not commit .env.
# =============================================================================

# API base URL
# Local dev (no Docker): backend runs on port 3000
VITE_API_URL=http://localhost:3000/api/v1
# Docker dev: backend is mapped to host port 3001
# VITE_API_URL=http://localhost:3001/api/v1

# Application
VITE_APP_NAME=Track It
VITE_APP_VERSION=1.0.0
