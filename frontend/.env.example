# =============================================================================
# Track It Frontend — Environment Variables
# Copy to .env and set values. Do not commit .env.
# =============================================================================

# API base URL (used for auth and all API calls; Phase 2 auth is at /api/v1/auth)
VITE_API_URL=http://localhost:3000/api

# Application
VITE_APP_NAME=Track It
VITE_APP_VERSION=1.0.0
