# =============================================================================
# Track It Frontend — Environment Variables
# Copy to .env and set values. Do not commit .env.
# =============================================================================

# API base URL — backend runs on port 3001 with /api/v1 prefix
VITE_API_URL=http://localhost:3001/api/v1

# Application
VITE_APP_NAME=Track It
VITE_APP_VERSION=1.0.0
